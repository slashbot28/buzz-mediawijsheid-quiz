rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // This security rules file assumes the following data structures:
    //
    // Collection: quiz_sets
    // Document ID: {setId} (URL-safe slug, e.g. 'mediawijsheid', 'ps5-buzz')
    // Fields:
    //   - title: string (required, non-empty, <= 120 chars) - Display title of the quiz set
    //   - categoriesJson: string (required, <= 100000 UTF-8 bytes) - JSON-serialized categories array
    //   - questionsJson: string (required, <= 800000 UTF-8 bytes) - JSON-serialized questions array
    //   - updatedAt: timestamp (required) - Last modification timestamp
    //   - editPin: string (optional, <= 32 chars) - Optional PIN protecting updates and deletes
    //
    // Note: Because this is a public Quiz Question Platform accessed via the
    // Firestore REST API without Firebase Auth (web quiz + external PS5 Buzz Quiz),
    // quiz_sets documents are publicly readable. Do not store PII or secrets in quiz_sets.
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user owns the resource (for user-owned documents)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verify UID hasn't been tampered with on create
    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    // Ensure uid field is not modified on update
    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    // Validate required fields exist
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // Validate that the document contains only the allowed fields
    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    // Validate string length (character count)
    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }

    // Validate optional string (if present, must be string and within character length)
    function isValidOptionalString(field, minLen, maxLen) {
      return !(field in request.resource.data) ||
        (request.resource.data[field] is string &&
         request.resource.data[field].size() >= minLen &&
         request.resource.data[field].size() <= maxLen);
    }

    // ===============================================================
    // Domain Validators (Used in both create and update)
    // ===============================================================

    function isValidQuizSet(data) {
      return hasOnlyAllowedFields(['title', 'categoriesJson', 'questionsJson', 'updatedAt', 'editPin']) &&
        hasRequiredFields(['title', 'categoriesJson', 'questionsJson', 'updatedAt']) &&
        validStringLength('title', 1, 120) &&
        data.categoriesJson is string && data.categoriesJson.toUtf8().size() <= 100000 &&
        data.questionsJson is string && data.questionsJson.toUtf8().size() <= 800000 &&
        data.updatedAt is timestamp &&
        isValidOptionalString('editPin', 0, 32);
    }

    // Verify editPin authorization on update:
    // Allowed if no editPin was set (or it was empty), or if the incoming editPin matches the existing one.
    function isAuthorizedQuizSetUpdate() {
      return !('editPin' in resource.data) ||
        resource.data.editPin == '' ||
        ('editPin' in request.resource.data && request.resource.data.editPin == resource.data.editPin);
    }

    // Verify editPin authorization on delete:
    // Allowed only if no editPin was set (or it was empty).
    function isAuthorizedQuizSetDelete() {
      return !('editPin' in resource.data) ||
        resource.data.editPin == '';
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    match /quiz_sets/{setId} {
      // Public read (get and list) for web quiz and external PS5 Buzz Quiz projects
      allow read: if true;

      // Public create with strict schema, type, and size validation
      allow create: if isValidQuizSet(request.resource.data);

      // Update requires valid schema/types/sizes AND matching editPin (if one is set)
      allow update: if isAuthorizedQuizSetUpdate() &&
        isValidQuizSet(request.resource.data);

      // Delete is only allowed when no editPin is set (or it is empty)
      allow delete: if isAuthorizedQuizSetDelete();
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
